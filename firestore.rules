rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myUser() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isTeacher() { return signedIn() && myUser().role == 'teacher'; }
    function isClassMember(classId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.memberIds;
    }
    function ownsClass(classId) {
      return signedIn() && get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == 'student';
      allow read: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
      allow delete: if false;
    }

    match /classes/{classId} {
      allow read: if signedIn() && (resource.data.teacherId == request.auth.uid || request.auth.uid in resource.data.memberIds);
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.auth.uid in request.resource.data.memberIds
          && !(request.auth.uid in resource.data.memberIds)
          && request.resource.data.memberIds.hasAll(resource.data.memberIds));
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    match /assignments/{assignmentId} {
      allow read: if isClassMember(resource.data.classId) || ownsClass(resource.data.classId);
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid && ownsClass(request.resource.data.classId);
      allow update, delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    match /answerKeys/{assignmentId} {
      allow read: if isTeacher() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid
        && get(/databases/$(database)/documents/assignments/$(assignmentId)).data.teacherId == request.auth.uid;
      allow update, delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    match /materials/{materialId} {
      allow read: if isClassMember(resource.data.classId) || ownsClass(resource.data.classId);
      allow create: if isTeacher() && request.resource.data.teacherId == request.auth.uid && ownsClass(request.resource.data.classId);
      allow update, delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    match /messages/{messageId} {
      allow read: if isClassMember(resource.data.classId) || ownsClass(resource.data.classId);
      allow create: if signedIn() && isClassMember(request.resource.data.classId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
      allow update, delete: if false;
    }

    match /submissions/{submissionId} {
      allow create, update, delete: if false; // Penilaian dan penyimpanan dilakukan Cloud Function.
      allow read: if signedIn() && (resource.data.studentId == request.auth.uid || ownsClass(resource.data.classId));
    }
  }
}
